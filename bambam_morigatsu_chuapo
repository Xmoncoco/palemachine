#!/usr/bin/env bash
# Verif des arguments
if [ -z "$1" ]; then
  echo "Usage: $0 <dossier>"
  exit 1
fi

dir="$1"

# Pour chaque fichier m4a du dossier
for m4a in "$dir"/*.m4a; do
  [ -e "$m4a" ] || continue  # Si aucun m4a, skip
  base="${m4a%.m4a}"
  jpg="${base}.jpg"
  
  # Si un jpg du même nom existe
  if [[ -f "$jpg" ]]; then
    echo "🖼️  Fusion de la cover pour : $(basename "$m4a")"
    
    # --- LA CORRECTION EST ICI ---
    ffmpeg -y -hide_banner -loglevel error \
      -i "$m4a" \
      -i "$jpg" \
      -map 0:a      `# Garde uniquement l'audio du fichier m4a` \
      -map 1:0      `# Prend l'image JPG` \
      -c:a copy     `# Copie l'audio sans réencoder` \
      -c:v mjpeg    `# FORCE LE VRAI FORMAT JPEG ICI` \
      -disposition:v:0 attached_pic `# Force l'image à être une COVER` \
      "${m4a}.tmp.m4a"

    if [[ $? -eq 0 ]]; then
      mv "${m4a}.tmp.m4a" "$m4a"
      rm "$jpg"
      echo "✅ Succès."
    else
      echo "❌ Erreur ffmpeg sur $m4a"
      rm -f "${m4a}.tmp.m4a"
    fi
  fi
done